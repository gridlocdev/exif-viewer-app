<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:ExifViewer.App"
        xmlns:core="using:ExifViewer.Core"
        x:Class="ExifViewer.App.MainWindow"
        Title="EXIF Viewer" Icon="/Assets/icon.png"
        Width="1100" Height="720" MinWidth="640" MinHeight="400"
        DragDrop.AllowDrop="True">

  <Window.Styles>
    <!-- Group headers: a flat toggle (chevron, name, count) instead of Fluent's boxed Expander. -->
    <Style Selector="ToggleButton.group">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0,10,0,6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ToggleButton.group:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.group:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.group:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    </Style>
    <Style Selector="ToggleButton.group Path.chevron">
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
    </Style>
    <Style Selector="ToggleButton.group:checked Path.chevron">
      <Setter Property="RenderTransform" Value="rotate(90deg)" />
    </Style>
  </Window.Styles>

  <!-- The macOS menu bar. Windows and Linux keep the toolbar and keyboard shortcuts only. -->
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="File">
        <NativeMenu>
          <NativeMenuItem Header="Open…" Gesture="Meta+O" Click="OnOpenClick" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Close Window" Gesture="Meta+W" Click="OnCloseClick" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="Edit">
        <NativeMenu>
          <NativeMenuItem Header="Cut" Gesture="Meta+X" Click="OnCutClick" />
          <NativeMenuItem Header="Copy" Gesture="Meta+C" Click="OnCopyClick" />
          <NativeMenuItem Header="Paste" Gesture="Meta+V" Click="OnPasteClick" />
          <NativeMenuItem Header="Select All" Gesture="Meta+A" Click="OnSelectAllClick" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Find" Gesture="Meta+F" Click="OnFindClick" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="View">
        <NativeMenu>
          <NativeMenuItem Header="Expand All Groups" Click="OnExpandAllClick" />
          <NativeMenuItem Header="Collapse All Groups" Click="OnCollapseAllClick" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Enter Full Screen" Gesture="Ctrl+Meta+F" Click="OnFullScreenClick" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="Window">
        <NativeMenu>
          <NativeMenuItem Header="Minimize" Gesture="Meta+M" Click="OnMinimizeClick" />
          <NativeMenuItem Header="Zoom" Click="OnZoomClick" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="Help">
        <NativeMenu>
          <NativeMenuItem Header="EXIF Viewer Help" Click="OnHelpClick" />
          <NativeMenuItem Header="Report an Issue" Click="OnReportIssueClick" />
        </NativeMenu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>

  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="12,8" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <DockPanel>
        <Button DockPanel.Dock="Left" Content="Open…" Click="OnOpenButtonClick" ToolTip.Tip="Open an image (Ctrl/Cmd+O)" />
        <TextBox DockPanel.Dock="Right" x:Name="FilterBox" Width="260" PlaceholderText="Filter tags"
                 TextChanged="OnFilterChanged" />
        <TextBlock x:Name="FileTitle" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="12,6" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <SelectableTextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.75"
                           Text="Drop an image on the window, or choose Open…" />
    </Border>

    <Grid ColumnDefinitions="2*,Auto,3*">
      <Panel Grid.Column="0" Margin="16">
        <LayoutTransformControl x:Name="PreviewTransform">
          <Image x:Name="PreviewImage" Stretch="Uniform" />
        </LayoutTransformControl>
        <TextBlock x:Name="PreviewPlaceholder" Text="No preview" Opacity="0.5"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Panel>

      <!-- A hairline divider; the transparent splitter on top of it gives a wider grab area. -->
      <Rectangle Grid.Column="1" Width="1" HorizontalAlignment="Center" IsHitTestVisible="False"
                 Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <GridSplitter Grid.Column="1" Width="7" ResizeDirection="Columns" Background="Transparent" />

      <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="GroupList" Margin="20,4,20,16">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="app:TagGroup">
              <StackPanel>
                <ToggleButton x:Name="Header" Classes="group" IsChecked="{Binding IsExpanded}">
                  <Border BorderThickness="0,0,0,1" Padding="0,0,0,6"
                          BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Path Classes="chevron" Data="M 0,0 L 4,4 L 0,8" Width="5" Height="8"
                            VerticalAlignment="Center" StrokeThickness="1.5"
                            Stroke="{Binding $parent[ToggleButton].Foreground}" />
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Tags.Count}" Opacity="0.45" />
                    </StackPanel>
                  </Border>
                </ToggleButton>
                <ItemsControl ItemsSource="{Binding Tags}" Margin="13,4,0,4"
                              IsVisible="{Binding #Header.IsChecked}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:MetadataTag">
                      <Grid ColumnDefinitions="200,*,Auto" Margin="0,3">
                        <TextBlock Grid.Column="0" Text="{Binding Name}" Opacity="0.7"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1">
                          <SelectableTextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                          <HyperlinkButton Content="Show on map" Padding="0" Margin="0,2,0,0"
                                           IsVisible="{Binding HasPosition}" Click="OnShowOnMapClick"
                                           ToolTip.Tip="{x:Static app:MainWindow.MapTip}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding IdHex}" Opacity="0.35" Margin="12,0,0,0"
                                   FontSize="11" VerticalAlignment="Center"
                                   FontFamily="Menlo, Consolas, DejaVu Sans Mono, monospace" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
